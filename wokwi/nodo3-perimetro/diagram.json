{
  "version": 1,
  "author": "G1 Pesca - Nodo 3 Perimetro (Gonzalo Aliaga Urbina)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-gas-sensor", "id": "mq2", "top": -150, "left": -230, "attrs": { "ppm": "400" } },
    { "type": "wokwi-potentiometer", "id": "viento", "top": 120, "left": -230, "attrs": {} },
    { "type": "wokwi-led", "id": "led_riesgo", "top": -120, "left": 200, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r_led", "top": -20, "left": 160, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "mq2:VCC", "esp:3V3", "red", [] ],
    [ "mq2:GND", "esp:GND.1", "black", [] ],
    [ "mq2:AOUT", "esp:34", "green", [] ],

    [ "viento:VCC", "esp:3V3", "red", [] ],
    [ "viento:GND", "esp:GND.1", "black", [] ],
    [ "viento:SIG", "esp:35", "blue", [] ],

    [ "esp:26", "r_led:1", "orange", [] ],
    [ "r_led:2", "led_riesgo:A", "orange", [] ],
    [ "led_riesgo:C", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
